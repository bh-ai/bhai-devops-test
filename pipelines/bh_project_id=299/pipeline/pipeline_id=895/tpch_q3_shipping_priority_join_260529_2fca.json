      },
      {
        "name": "orders",
        "transformation": "Reader",
        "dependent_on": [],
        "source": {
          "$ref": "#/sources/orders"
        },
        "rename_columns": {
          "o_orderkey": "o_orderkey_src_3",
          "o_custkey": "o_custkey_src_3",
          "o_orderstatus": "o_orderstatus_src_3",
          "o_totalprice": "o_totalprice_src_3",
          "o_orderdate": "o_orderdate_src_3",
          "o_orderpriority": "o_orderpriority_src_3",
          "o_clerk": "o_clerk_src_3",
          "o_shippriority": "o_shippriority_src_3",
          "o_comment": "o_comment_src_3"
        },
        "read_options": {
          "dbtable": "orders"
        }
      },
      {
        "name": "JoinCustomerOrders",
        "transformation": "Joiner",
        "dependent_on": [
          "customer",
          "orders"
        ],
        "conditions": [
          {
            "join_input": "orders",
            "join_condition": "c_custkey_src_2 = o_custkey_src_3",
            "join_type": "inner"
          }
        ]
      },
      {
        "name": "JoinAllTables",
        "transformation": "Joiner",
        "dependent_on": [
          "JoinCustomerOrders",
          "lineitem"
        ],
        "conditions": [
          {
            "join_input": "lineitem",
            "join_condition": "o_orderkey_src_3 = l_orderkey_src_1",
            "join_type": "inner"
          }
        ]
      },
      {
        "name": "FilterConditions",
        "transformation": "Filter",
        "dependent_on": [
          "JoinAllTables"
        ],
        "condition": "c_mktsegment_src_2 = 'BUILDING' AND to_date(o_orderdate_src_3) < DATE '1995-03-15' AND to_date(l_shipdate_src_1) > DATE '1995-03-15'"
      },
      {
        "name": "PreAggregationExpression",
        "transformation": "Expression",
        "dependent_on": [
          "FilterConditions"
        ],
        "derived_fields": [
          {
            "name": "line_revenue",
            "expression": "l_extendedprice_src_1 * (1 - l_discount_src_1)"
          }
        ],
        "select_columns": [
          "l_orderkey_src_1",
          "o_orderdate_src_3",
          "o_shippriority_src_3",
          "line_revenue"
        ]
      },
      {
        "name": "AggregateRevenue",
        "transformation": "Aggregator",
        "dependent_on": [
          "PreAggregationExpression"
        ],
        "group_by": [
          "l_orderkey_src_1",
          "o_orderdate_src_3",
          "o_shippriority_src_3"
        ],
        "aggregate": [
          {
            "expression": "round(sum(line_revenue), 2)",
            "target_column": "revenue"
          }
        ]
      },
      {
        "name": "SortResults",
        "transformation": "Sorter",
        "dependent_on": [
          "AggregateRevenue"
        ],
        "sort_columns": [
          {
            "column": "revenue",
            "order": "desc"
          },
          {
            "column": "o_orderdate_src_3",
            "order": "asc"
          }
        ]
      },
      {
        "name": "tpch_q3_results_final",
        "transformation": "Expression",
        "dependent_on": [
          "SortResults"
        ],
        "derived_fields": [
          {
            "name": "l_orderkey",
            "expression": "l_orderkey_src_1"
          },
          {
            "name": "o_orderdate",
            "expression": "CAST(o_orderdate_src_3 AS DATE)"
          },
          {
            "name": "o_shippriority",
            "expression": "o_shippriority_src_3"
          }
        ],
        "select_columns": [
          "l_orderkey",
          "revenue",
          "o_orderdate",
          "o_shippriority"
        ]
      },
      {
        "name": "tpch_q3_results",
        "transformation": "Writer",
        "dependent_on": [
          "tpch_q3_results_final"
        ],
        "target": {
          "$ref": "#/targets/tpch_q3_results"
        },
        "write_options": {
          "mode": "overwrite",
          "dbtable": "tpch_q3_results"
        }
