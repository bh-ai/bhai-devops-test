  "rule_substituted": "WITH allowed_vals AS (SELECT TRIM(value) AS val_text FROM (SELECT EXPLODE(SPLIT('MALE, FEMALE, UNKNOWN', ',')) AS value)), allowed_cast AS (SELECT CAST(val_text AS String) AS val FROM allowed_vals), failed AS (SELECT COUNT(*) AS fail_rows FROM cinqdev.default.member t WHERE 1=1 AND t.gender NOT IN (SELECT val FROM allowed_cast)), total AS (SELECT COUNT(*) AS total_rows FROM cinqdev.default.member WHERE 1=1) SELECT total_rows AS rows_total, total_rows - fail_rows AS rows_passed, fail_rows AS rows_failed, CASE WHEN try_divide(fail_rows * 100.0, total_rows) <= 0 THEN 'PASS' ELSE 'FAIL' END AS status FROM failed, total;"
